{
  "schemaVersion":"0.2",
  "plugins":["echarts"],
  "app":{"name":"PluginChartApp","window":{"width":900,"height":620}},
  "state":{
    "chartOption":{"title":{"text":"ECharts plugin"},"xAxis":{"type":"category","data":["A","B","C"]},"yAxis":{"type":"value"},"series":[{"type":"bar","data":[12,24,18]}]},
    "selected":"Click a bar",
    "dispatchResult":false
  },
  "root":{"type":"column","id":"page","layout":{"gap":12,"padding":16},"children":[
    {"type":"plugin","id":"cpuChart","component":"echarts.chart","layout":{"height":{"fixed":440},"width":{"fr":1}},"props":{"option":{"kind":"state","key":"chartOption"}},"events":{"click":"chartClick"}},
    {"type":"text","id":"selection","text":{"kind":"state","key":"selected"}},
    {"type":"button","id":"highlight","text":{"kind":"literal","value":"Highlight B"},"events":{"click":"highlightBar"}}
  ]},
  "actions":{
    "chartClick":{"eventPayload":{"seriesIndex":0,"dataIndex":0,"name":"","value":0},"steps":[{"type":"set","target":"selected","value":{"kind":"event","path":"/name"}}]},
    "highlightBar":{"steps":[{"type":"pluginCall","target":"cpuChart","method":"dispatchAction","args":{"kind":"literal","value":{"type":"highlight","seriesIndex":0,"dataIndex":1}},"resultTarget":"dispatchResult"}]}
  }
}
