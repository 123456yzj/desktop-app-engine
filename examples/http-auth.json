{
  "schemaVersion":"0.2",
  "credentialStore":"http-auth-demo",
  "app":{"name":"加密凭据 API 测试","window":{"width":800,"height":480}},
  "state":{
    "requestStatus":{"status":"idle","loading":false,"statusCode":0,"error":"","updatedAt":0},
    "message":"点击请求，使用当前用户加密保存的 api-token",
    "count":0
  },
  "dataSources":{
    "protected":{
      "url":"http://127.0.0.1:8766/protected",
      "headers":{"Authorization":{"kind":"credential","name":"api-token","prefix":"Bearer "}},
      "statusTarget":"requestStatus",
      "responseSample":{"data":{"message":"认证成功","count":1}},
      "mappings":[{"target":"message","path":"/data/message"},{"target":"count","path":"/data/count"}]
    }
  },
  "root":{"type":"column","id":"page","layout":{"padding":24,"gap":16},"children":[
    {"type":"text","id":"heading","style":{"fontSize":26},"text":{"kind":"literal","value":"加密凭据认证"}},
    {"type":"text","id":"description","style":{"fontSize":14,"color":"textMuted"},"text":{"kind":"literal","value":"凭据由 Windows 当前用户加密保存；页面配置只引用凭据名称。"}},
    {"type":"button","id":"request","text":{"kind":"literal","value":"请求受保护接口"},"events":{"click":"request"}},
    {"type":"badge","id":"status","tone":"accent","text":{"kind":"state","key":"requestStatus","path":"/status"}},
    {"type":"text","id":"message","text":{"kind":"state","key":"message"}},
    {"type":"metric","id":"count","label":{"kind":"literal","value":"认证请求计数"},"value":{"kind":"state","key":"count"}},
    {"type":"text","id":"error","style":{"color":"danger"},"text":{"kind":"state","key":"requestStatus","path":"/error"}}
  ]},
  "actions":{"request":{"steps":[{"type":"request","source":"protected"}]}}
}
