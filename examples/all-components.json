                        {"type": "table", "id": "tableDemo", "rows": {"kind": "state", "key": "servers"}, "rowKey": "id", "rowHeight": 36, "pageSize": 3, "current": {"kind": "state", "key": "tablePage"}, "bordered": true, "layout": {"height": {"fixed": 230}}, "columns": [
