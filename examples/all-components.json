                          {"id": "online", "field": "online", "title": "在线", "width": {"fixed": 100}}
                        ], "events": {"rowSelect": "rowSelected", "sortChange": "tableSorted"}},
                        {"type": "lineChart", "id": "lineChartDemo", "title": {"kind": "literal", "value": "LineChart 折线趋势"}, "layout": {"height": {"fixed": 280}}, "series": [{"id": "line", "name": "请求量", "data": {"kind": "state", "key": "trend"}, "xField": "x", "yField": "y", "monotonicX": true}], "legend": true, "zoom": true, "pan": true, "yAxis": {"min": 0, "max": 100}},
                        {"type": "barChart", "id": "barChartDemo", "title": {"kind": "literal", "value": "BarChart 柱状分布"}, "layout": {"height": {"fixed": 280}}, "series": [{"id": "bar", "name": "任务量", "data": {"kind": "state", "key": "trend"}, "xField": "x", "yField": "y"}], "legend": true, "yAxis": {"min": 0, "max": 100}},
                        {"type": "text", "id": "pluginTitle", "text": {"kind": "literal", "value": "Plugin · ECharts（点击柱子可更新状态栏）"}, "style": {"fontSize": 18}},
                        {"type": "plugin", "id": "pluginDemo", "component": "echarts.chart", "layout": {"height": {"fixed": 320}}, "props": {"option": {"kind": "literal", "value": {
                          "animation": false, "title": {"text": "ECharts Plugin", "left": "center"},
                          "grid": {"left": 55, "right": 24, "top": 60, "bottom": 45},
                          "xAxis": {"type": "category", "data": ["Layout", "Input", "Display", "Feedback"]},
                          "yAxis": {"type": "value"}, "series": [{"type": "bar", "data": [20, 18, 24, 22], "itemStyle": {"color": "#1677ff"}}]
                        }}}, "events": {"click": "pluginClicked"}}
                      ]
                    },
                    {
                      "type": "column", "id": "pageFeedback", "layout": {"height": {"fr": 1}, "padding": 12, "gap": 16, "overflow": "scroll"},
                      "children": [
                        {"type": "text", "id": "feedbackIntro", "text": {"kind": "literal", "value": "反馈与弹窗：点击按钮打开，Esc 或关闭按钮退出。"}, "style": {"fontSize": 20}},
                        {"type": "space", "id": "overlayButtons", "layout": {"wrap": true}, "children": [
                          {"type": "button", "id": "showModal", "text": {"kind": "literal", "value": "Modal 对话框"}, "events": {"click": "showModal"}},
                          {"type": "button", "id": "showDrawer", "text": {"kind": "literal", "value": "Drawer 抽屉"}, "events": {"click": "showDrawer"}},
                          {"type": "button", "id": "showMessage", "text": {"kind": "literal", "value": "Message 消息"}, "events": {"click": "showMessage"}},
                          {"type": "button", "id": "showNotification", "text": {"kind": "literal", "value": "Notification 通知"}, "events": {"click": "showNotification"}},
                          {"type": "button", "id": "showTour", "text": {"kind": "literal", "value": "Tour 导览"}, "events": {"click": "showTour"}}
                        ]},
                        {"type": "space", "id": "popupButtons", "children": [
                          {"type": "popover", "id": "popoverDemo", "text": "Popover 点击查看", "title": "气泡说明", "description": "支持点击打开和外部点击关闭。"},
                          {"type": "tooltip", "id": "tooltipDemo", "text": "Tooltip 悬停查看", "description": "这里是悬停提示。"},
                          {"type": "popconfirm", "id": "popconfirmDemo", "text": "Popconfirm 确认操作", "description": "确定执行演示操作吗？", "okText": "确定", "cancelText": "取消", "events": {"confirm": "confirmed"}}
                        ]},
                        {"type": "alert", "id": "alertDemo", "text": "Alert · 全部组件已载入", "description": "这是可关闭的成功提示。", "status": "success", "showIcon": true, "closable": true, "layout": {"height": {"fixed": 85}}},
                        {"type": "result", "id": "resultDemo", "title": "Result · 操作完成", "subTitle": "组件展示应用已准备就绪", "status": "success", "layout": {"height": {"fixed": 140}}},
                        {"type": "text", "id": "skeletonTitle", "text": {"kind": "literal", "value": "Skeleton 骨架屏"}, "style": {"fontSize": 18}},
                        {"type": "skeleton", "id": "skeletonDemo", "rows": 3, "avatar": true, "active": true, "layout": {"height": {"fixed": 120}}},
                        {"type": "switch", "id": "spinSwitch", "text": {"kind": "literal", "value": "切换 Spin 加载状态"}, "value": {"kind": "state", "key": "spinning"}},
                        {"type": "spin", "id": "spinDemo", "spinning": {"kind": "state", "key": "spinning"}, "tip": "加载中", "layout": {"height": {"fixed": 110}, "padding": 16}, "children": [
                          {"type": "text", "id": "spinContent", "text": {"kind": "literal", "value": "Spin 内容区域：打开加载状态时覆盖指示器并禁用子控件。"}},
                          {"type": "button", "id": "spinChild", "text": {"kind": "literal", "value": "内容中的操作"}, "events": {"click": "clicked"}}
                        ]}
                      ]
                    }
                  ]
                }]
              }
            ]
          },
          {"type": "footer", "id": "footer", "layout": {"height": {"fixed": 44}, "padding": 10}, "children": [
            {"type": "text", "id": "statusText", "text": {"kind": "state", "key": "status"}, "ellipsis": true, "style": {"fontSize": 14}}
          ]}
        ]
      },
      {"type": "modal", "id": "modalDemo", "open": {"kind": "state", "key": "modalOpen"}, "title": "Modal 编辑资料", "width": 520, "events": {"ok": "saveModal"}, "children": [
        {"type": "text", "id": "modalHint", "text": {"kind": "literal", "value": "此输入与表单姓名共用状态。确定后关闭并显示成功消息。"}},
        {"type": "input", "id": "modalName", "value": {"kind": "state", "key": "formName"}}
      ]},
      {"type": "drawer", "id": "drawerDemo", "open": {"kind": "state", "key": "drawerOpen"}, "title": "组件展示操作指南", "placement": "right", "width": 420, "children": [
        {"type": "text", "id": "drawerGuide", "text": {"kind": "literal", "value": "1. 左侧菜单与顶部标签切换六个分区。\n2. 每个分区独立滚动，展示全部 84 种组件。\n3. 表单支持必填校验、提交和重置。\n4. 表格支持排序、选行和分页。\n5. 图表支持悬停，内置折线图支持缩放和平移。\n6. ECharts 插件及 Node 运行库已打入应用。\n7. Upload 仅选择并记录本地文件。\n8. Image 当前展示占位，可在 JSON 配置图片来源。\n9. Esc 或关闭按钮可退出弹窗。"}}
      ]},
      {"type": "message", "id": "messageDemo", "open": {"kind": "state", "key": "messageOpen"}, "text": "Message · 操作成功", "status": "success", "duration": 3, "placement": "top"},
      {"type": "notification", "id": "notificationDemo", "open": {"kind": "state", "key": "notificationOpen"}, "title": "Notification 通知", "description": "所有组件均可在对应分区中体验。", "duration": 5, "placement": "bottomRight"},
      {"type": "tour", "id": "tourDemo", "open": {"kind": "state", "key": "tourOpen"}, "current": {"kind": "state", "key": "tourStep"}, "steps": [
        {"key": "welcome", "label": "欢迎", "description": "应用展示协议 0.2 的全部 84 种组件。"},
        {"key": "sections", "label": "浏览分区", "description": "使用左侧菜单或顶部标签浏览；每个分区支持滚动。"},
        {"key": "interact", "label": "开始体验", "description": "编辑表单、拖动分割条、切换分页，或打开其他弹窗。"}
      ]},
      {"type": "floatButton", "id": "floatButtonDemo", "icon": "?", "description": "指南", "tooltip": "打开操作指南", "offsetX": 24, "offsetY": 65, "events": {"click": "showDrawer"}}
      ]
    }]
  },
  "actions": {
    "navigate": {"eventPayload": "pageLayout", "steps": [{"type": "set", "target": "activePage", "value": {"kind": "event"}}, {"type": "concat", "target": "menuSelectionJson", "parts": [{"kind": "literal", "value": "[\""}, {"kind": "event"}, {"kind": "literal", "value": "\"]"}]}]},
    "prepareMenuSelection": {"eventPayload": "pageLayout", "steps": [{"type": "concat", "target": "menuSelectionJson", "parts": [{"kind": "literal", "value": "[\""}, {"kind": "event"}, {"kind": "literal", "value": "\"]"}]}]},
    "syncMenu": {"steps": [{"type": "parseJson", "target": "selectedMenu", "value": {"kind": "state", "key": "menuSelectionJson"}}]},
    "clicked": {"steps": [{"type": "set", "target": "status", "value": {"kind": "literal", "value": "Button 点击事件已执行。"}}]},
    "receiveModule": {"eventPayload": "", "steps": [{"type": "set", "target": "sharedMessage", "value": {"kind": "event"}}, {"type": "set", "target": "status", "value": {"kind": "literal", "value": "Module 已将草稿发送给父级。"}}]},
    "saveForm": {"steps": [{"type": "concat", "target": "status", "parts": [{"kind": "literal", "value": "表单校验通过，姓名："}, {"kind": "state", "key": "formName"}]}]},
    "invalidForm": {"steps": [{"type": "set", "target": "status", "value": {"kind": "literal", "value": "表单校验未通过，请检查姓名、年龄和条款。"}}]},
    "resetForm": {"steps": [{"type": "set", "target": "status", "value": {"kind": "literal", "value": "表单字段已恢复初始值。"}}]},
    "anchorClicked": {"eventPayload": {"key": "intro", "href": "#navigationIntro"}, "steps": [{"type": "concat", "target": "status", "parts": [{"kind": "literal", "value": "Anchor 点击："}, {"kind": "event", "path": "/href"}]}]},
    "dropdownClicked": {"eventPayload": "refresh", "steps": [{"type": "concat", "target": "status", "parts": [{"kind": "literal", "value": "Dropdown 选择："}, {"kind": "event"}]}]},
    "rowSelected": {"eventPayload": "alpha", "steps": [{"type": "concat", "target": "status", "parts": [{"kind": "literal", "value": "Table 选中行："}, {"kind": "event"}]}]},
    "tableSorted": {"steps": [{"type": "set", "target": "status", "value": {"kind": "literal", "value": "Table 排序已更新。"}}]},
    "pluginClicked": {"eventPayload": {"seriesIndex": 0, "dataIndex": 0, "name": "", "value": 0}, "steps": [{"type": "concat", "target": "status", "parts": [{"kind": "literal", "value": "ECharts 插件点击："}, {"kind": "event", "path": "/name"}]}]},
    "showModal": {"steps": [{"type": "set", "target": "modalOpen", "value": {"kind": "literal", "value": true}}]},
    "saveModal": {"steps": [{"type": "set", "target": "modalOpen", "value": {"kind": "literal", "value": false}}, {"type": "set", "target": "messageOpen", "value": {"kind": "literal", "value": true}}]},
    "showDrawer": {"steps": [{"type": "set", "target": "drawerOpen", "value": {"kind": "literal", "value": true}}]},
    "showMessage": {"steps": [{"type": "set", "target": "messageOpen", "value": {"kind": "literal", "value": true}}]},
    "showNotification": {"steps": [{"type": "set", "target": "notificationOpen", "value": {"kind": "literal", "value": true}}]},
    "showTour": {"steps": [{"type": "set", "target": "tourStep", "value": {"kind": "literal", "value": 0}}, {"type": "set", "target": "tourOpen", "value": {"kind": "literal", "value": true}}]},
    "confirmed": {"steps": [{"type": "set", "target": "status", "value": {"kind": "literal", "value": "Popconfirm 操作已确认。"}}, {"type": "set", "target": "messageOpen", "value": {"kind": "literal", "value": true}}]}
  }
}
