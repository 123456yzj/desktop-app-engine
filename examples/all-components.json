    "prepareMenuSelection": {"eventPayload": "pageLayout", "steps": [{"type": "concat", "target": "menuSelectionJson", "parts": [{"kind": "literal", "value": "[\""}, {"kind": "event"}, {"kind": "literal", "value": "\"]"}]}]},
    "syncMenu": {"steps": [{"type": "parseJson", "target": "selectedMenu", "value": {"kind": "state", "key": "menuSelectionJson"}}]},
    "clicked": {"steps": [{"type": "set", "target": "status", "value": {"kind": "literal", "value": "Button 点击事件已执行。"}}]},
    "receiveModule": {"eventPayload": "", "steps": [{"type": "set", "target": "sharedMessage", "value": {"kind": "event"}}, {"type": "set", "target": "status", "value": {"kind": "literal", "value": "Module 已将草稿发送给父级。"}}]},
    "saveForm": {"steps": [{"type": "concat", "target": "status", "parts": [{"kind": "literal", "value": "表单校验通过，姓名："}, {"kind": "state", "key": "formName"}]}]},
    "invalidForm": {"steps": [{"type": "set", "target": "status", "value": {"kind": "literal", "value": "表单校验未通过，请检查姓名、年龄和条款。"}}]},
    "resetForm": {"steps": [{"type": "set", "target": "status", "value": {"kind": "literal", "value": "表单字段已恢复初始值。"}}]},
    "anchorClicked": {"eventPayload": {"key": "intro", "href": "#navigationIntro"}, "steps": [{"type": "concat", "target": "status", "parts": [{"kind": "literal", "value": "Anchor 点击："}, {"kind": "event", "path": "/href"}]}]},
    "dropdownClicked": {"eventPayload": "refresh", "steps": [{"type": "concat", "target": "status", "parts": [{"kind": "literal", "value": "Dropdown 选择："}, {"kind": "event"}]}]},
    "rowSelected": {"eventPayload": "alpha", "steps": [{"type": "concat", "target": "status", "parts": [{"kind": "literal", "value": "Table 选中行："}, {"kind": "event"}]}]},
    "tableSorted": {"steps": [{"type": "set", "target": "status", "value": {"kind": "literal", "value": "Table 排序已更新。"}}]},
    "pluginClicked": {"eventPayload": {"seriesIndex": 0, "dataIndex": 0, "name": "", "value": 0}, "steps": [{"type": "concat", "target": "status", "parts": [{"kind": "literal", "value": "ECharts 插件点击："}, {"kind": "event", "path": "/name"}]}]},
    "showModal": {"steps": [{"type": "set", "target": "modalOpen", "value": {"kind": "literal", "value": true}}]},
    "saveModal": {"steps": [{"type": "set", "target": "modalOpen", "value": {"kind": "literal", "value": false}}, {"type": "set", "target": "messageOpen", "value": {"kind": "literal", "value": true}}]},
    "showDrawer": {"steps": [{"type": "set", "target": "drawerOpen", "value": {"kind": "literal", "value": true}}]},
    "showMessage": {"steps": [{"type": "set", "target": "messageOpen", "value": {"kind": "literal", "value": true}}]},
    "showNotification": {"steps": [{"type": "set", "target": "notificationOpen", "value": {"kind": "literal", "value": true}}]},
    "showTour": {"steps": [{"type": "set", "target": "tourStep", "value": {"kind": "literal", "value": 0}}, {"type": "set", "target": "tourOpen", "value": {"kind": "literal", "value": true}}]},
    "confirmed": {"steps": [{"type": "set", "target": "status", "value": {"kind": "literal", "value": "Popconfirm 操作已确认。"}}, {"type": "set", "target": "messageOpen", "value": {"kind": "literal", "value": true}}]}
  }
