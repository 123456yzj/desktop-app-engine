{
  "schemaVersion": "0.2",
  "app": {"name": "vben-package-legacy", "window": {"width": 1120, "height": 900}},
  "state": {
    "sshTarget": "",
    "repository": "/home/wwwroot/web-framework/current/",
    "branch": "",
    "idle": true,
    "busy": false,
    "activeTask": "",
    "switchAvailable": false,
    "settingsOpen": true,
    "settingsClosed": false,
    "lastResponse": "{}",
    "view": {"currentBranch": "尚未读取", "branches": "", "ready": false, "hasBranches": false, "summary": "配置连接后，读取项目分支", "detail": "选择目标分支并切换，然后对当前分支进行打包。", "success": false, "failure": false, "buildBranch": "—", "buildResult": "尚未打包", "buildTime": "—", "duration": "—", "project": ""},
    "job": {"status": "idle", "running": false, "exitCode": -1, "stdout": "", "stderr": "", "error": ""},
    "commandScript": "[Console]::OutputEncoding=[Text.UTF8Encoding]::new($false); $OutputEncoding=[Console]::OutputEncoding; $runnerArgs=@($args | Select-Object -Skip 1); & ([scriptblock]::Create($args[0])) @runnerArgs; exit $LASTEXITCODE",
    "runner": "$ErrorActionPreference='Stop'; $PSNativeCommandUseErrorActionPreference=$false; $operation,$destination,$repository,$branch,$last=$args; $watch=[Diagnostics.Stopwatch]::StartNew(); $view=[ordered]@{currentBranch='尚未读取';branches='';ready=$false;hasBranches=$false;summary='';detail='';success=$false;failure=$false;buildBranch='—';buildResult='尚未打包';buildTime='—';duration='—';project=''}; $code=2; $current=$null; $found=[Collections.Generic.List[string]]::new(); $diagnostics=[Collections.Generic.List[string]]::new(); try { $previous=$last | ConvertFrom-Json; if ($previous.project -eq ($destination+' '+$repository)) { foreach ($key in @('branches','buildBranch','buildResult','buildTime')) { if ($null -ne $previous.$key) { $view[$key]=[string]$previous.$key } } }; $destination=$destination.Trim(); if ([string]::IsNullOrWhiteSpace($destination) -or $destination.StartsWith('-') -or $destination -match '\\s') { throw '请在连接设置中填写 SSH 地址或配置别名。' }; if (!$repository.StartsWith('/') -or $repository.Contains([char]0)) { throw '请填写 Linux 仓库绝对路径。' }; function Q([string]$s) { $q=[string][char]39; return $q+$s.Replace($q,($q+[char]34+$q+[char]34+$q))+$q }; $report='rc=$?; set +e; printf \u0022[vben] stage=%s exit=%s\\n\u0022 \u0022$stage\u0022 \u0022$rc\u0022 >&2; if [ \u0022$repo_ready\u0022 = 1 ]; then b=$(git symbolic-ref --quiet --short HEAD || true); printf \u0022\\n__VBEN_CURRENT__%s\\n\u0022 \u0022$b\u0022; fi; exit \u0022$rc\u0022'; $remote='set -euo pipefail; export GIT_TERMINAL_PROMPT=0 GIT_MERGE_AUTOEDIT=no; stage=repository; repo_ready=0; trap '+(Q $report)+' EXIT; cd -- '+(Q $repository)+'; git rev-parse --git-dir >/dev/null; repo_ready=1; '; switch ($operation) { 'refresh' { $view.branches=''; $remote+='stage=fetch; git fetch --all --prune >&2; stage=branches; local_branches=$(git for-each-ref --format='+(Q '%(refname:lstrip=2)')+' refs/heads); remote_branches=$(git for-each-ref --format='+(Q '%(if)%(symref)%(then)%(else)%(refname:lstrip=3)%(end)')+' refs/remotes); printf '+(Q '%s\n')+' \u0022$local_branches\u0022 \u0022$remote_branches\u0022 | sed '+(Q '/^$/d')+' | sort -u | while IFS= read -r name; do printf '+(Q '__VBEN_BRANCH__%s\n')+' \u0022$name\u0022; done;' } 'switch' { if ([string]::IsNullOrWhiteSpace($branch)) { throw '请先选择目标分支。' }; $remote+='stage=branch-check; branch='+(Q $branch)+'; git check-ref-format --branch \u0022$branch\u0022 >/dev/null; stage=fetch; git fetch --all --prune; stage=checkout; git checkout \u0022$branch\u0022 --;' } 'pull' { $remote+='stage=pull; git pull;' } 'build' { $view.buildBranch=[string]$previous.currentBranch; $view.buildTime=Get-Date -Format 'yyyy-MM-dd HH:mm:ss'; $remote+='stage=branch-check; actual=$(git symbolic-ref --quiet --short HEAD || true); if [ \u0022$actual\u0022 != '+(Q ([string]$previous.currentBranch))+ ' ]; then printf '+(Q '当前分支已发生变化，请确认当前分支后重新打包。\n')+' >&2; set +e; exit 4; fi; stage=clean-turbo; printf \u0022[vben] cleaning project .turbo\\n\u0022 >&2; rm -rf -- ./.turbo; stage=build; pnpm build:dev:tms;' } default { throw '未知操作。' } }; [Console]::Error.WriteLine('[vben] operation='+$operation+' started'); & ssh.exe -T -o BatchMode=yes -o ConnectTimeout=15 -- $destination ('bash -lc '+(Q $remote)) 2>&1 | ForEach-Object { $line=$_.ToString(); if ($line.StartsWith('__VBEN_CURRENT__')) { $current=$line.Substring(16) } elseif ($operation -eq 'refresh' -and $line.StartsWith('__VBEN_BRANCH__')) { $found.Add($line.Substring(15)) } elseif (![string]::IsNullOrWhiteSpace($line)) { [Console]::Error.WriteLine($line); $diagnostics.Add($line); if ($diagnostics.Count -gt 80) { $diagnostics.RemoveAt(0) } } }; $code=$LASTEXITCODE; [Console]::Error.WriteLine('[vben] operation='+$operation+' exit='+$code); if ($operation -eq 'refresh' -and $code -eq 0) { $view.branches=($found | Sort-Object -Unique) -join \u0022`n\u0022 }; $view.project=$destination+' '+$repository; if ($null -ne $current) { $view.currentBranch=if ($current) { $current } else { '游离提交（请先切换分支）' }; $view.ready=![string]::IsNullOrWhiteSpace($current); $view.hasBranches=![string]::IsNullOrWhiteSpace($view.branches) }; if ($code -eq 0) { $view.success=$true; switch ($operation) { 'refresh' { $view.summary='项目分支已更新'; $view.detail='共 '+$found.Count+' 个可选分支。选择分支后，点击切换。' } 'switch' { $view.summary='分支切换成功'; $view.detail='当前分支：'+$view.currentBranch+'。可以直接打包，或先更新当前分支代码。' } 'pull' { $view.summary='当前分支代码更新完成'; $view.detail='当前分支：'+$view.currentBranch+'。可以开始打包。' } 'build' { $view.summary='打包成功'; $view.detail='构建命令已成功结束，产物保留在服务器。'; $view.buildResult='打包成功' } } } else { $view.failure=$true; $view.summary=switch ($operation) { 'refresh' {'读取分支失败'} 'switch' {'分支切换失败'} 'pull' {'代码更新失败'} 'build' {'打包失败'} }; $text=$diagnostics -join \u0022`n\u0022; $view.detail=if ($text -match 'no such ref was fetched') { '当前分支的远端跟踪分支不存在，请选择其他分支或联系维护人员。' } elseif ($text -match 'would be overwritten|CONFLICT') { 'Git 检测到文件冲突，请联系维护人员处理后重试。' } elseif ($text -match 'Permission denied|Could not resolve hostname|Connection refused|timed out|Host key verification failed') { '连接服务器失败，请检查连接设置和本机 SSH 配置。' } elseif ($text -match '当前分支已发生变化') { '服务器当前分支已改变，请核对当前分支后重新打包。' } else { '操作未完成（退出码 '+$code+'），请查看实时日志中的失败阶段和具体错误。' } } } catch { [Console]::Error.WriteLine($_.Exception.Message); $view.failure=$true; $view.summary='操作未完成'; $view.detail=$_.Exception.Message; $code=2 }; if ($operation -eq 'build' -and $code -ne 0) { $view.buildResult='打包失败' }; $view.duration=[math]::Round($watch.Elapsed.TotalSeconds,1).ToString()+' 秒'; $view | ConvertTo-Json -Compress -Depth 5; exit $code"
  },
  "root": {"type": "column", "id": "page", "layout": {"padding": 28, "gap": 18, "overflow": "scroll"}, "style": {"background": "surface"}, "children": [
    {"type": "row", "id": "header", "layout": {"gap": 16, "justify": "spaceBetween", "align": "center"}, "children": [
      {"type": "column", "id": "brand", "layout": {"gap": 6}, "children": [
        {"type": "text", "id": "eyebrow", "style": {"fontSize": 12, "color": "primary"}, "text": {"kind": "literal", "value": "VBEN  /  PROJECT WORKSPACE"}},
        {"type": "text", "id": "title", "style": {"fontSize": 28}, "text": {"kind": "literal", "value": "项目构建工作台"}},
        {"type": "text", "id": "subtitle", "style": {"fontSize": 13, "color": "textMuted"}, "text": {"kind": "literal", "value": "查看项目分支，切换代码版本，完成远程打包。"}}
      ]},
      {"type": "row", "id": "settingsActions", "enabled": {"kind": "state", "key": "idle"}, "children": [
        {"type": "button", "id": "openSettings", "visible": {"kind": "state", "key": "settingsClosed"}, "text": {"kind": "literal", "value": "连接设置"}, "events": {"click": "openSettings"}},
        {"type": "button", "id": "closeSettings", "visible": {"kind": "state", "key": "settingsOpen"}, "text": {"kind": "literal", "value": "收起设置"}, "events": {"click": "closeSettings"}}
      ]}
    ]},
    {"type": "card", "id": "connection", "visible": {"kind": "state", "key": "settingsOpen"}, "enabled": {"kind": "state", "key": "idle"}, "layout": {"padding": 20, "gap": 12}, "style": {"radius": 12, "borderWidth": 1}, "children": [
      {"type": "text", "id": "connectionTitle", "style": {"fontSize": 16}, "text": {"kind": "literal", "value": "项目连接"}},
      {"type": "grid", "id": "connectionFields", "columns": [{"fr": 1}, {"fr": 2}], "layout": {"gap": 18}, "children": [
        {"type": "column", "id": "hostField", "layout": {"gap": 8}, "children": [
          {"type": "text", "id": "hostLabel", "style": {"fontSize": 13, "color": "textMuted"}, "text": {"kind": "literal", "value": "服务器 / SSH 别名"}},
          {"type": "input", "id": "sshTarget", "value": {"kind": "state", "key": "sshTarget"}, "placeholder": {"kind": "literal", "value": "user@host 或 SSH 别名"}, "events": {"change": "resetProject"}}
        ]},
        {"type": "column", "id": "repoField", "layout": {"gap": 8}, "children": [
          {"type": "text", "id": "repoLabel", "style": {"fontSize": 13, "color": "textMuted"}, "text": {"kind": "literal", "value": "项目目录"}},
          {"type": "input", "id": "repository", "value": {"kind": "state", "key": "repository"}, "events": {"change": "resetProject"}}
        ]}
      ]},
      {"type": "text", "id": "connectionHint", "style": {"fontSize": 12, "color": "textMuted"}, "text": {"kind": "literal", "value": "使用本机已有的 SSH 私钥配置。填写后点击下方“读取 / 刷新分支”。"}}
    ]},
    {"type": "grid", "id": "workspace", "columns": [{"fr": 1.35}, {"fr": 1}], "layout": {"gap": 18}, "children": [
      {"type": "card", "id": "branchCard", "layout": {"padding": 22, "gap": 14}, "style": {"radius": 12, "borderWidth": 1}, "children": [
        {"type": "text", "id": "branchSection", "style": {"fontSize": 12, "color": "primary"}, "text": {"kind": "literal", "value": "01  /  项目分支"}},
        {"type": "text", "id": "currentLabel", "style": {"fontSize": 13, "color": "textMuted"}, "text": {"kind": "literal", "value": "当前所在分支"}},
        {"type": "text", "id": "currentBranch", "style": {"fontSize": 26}, "text": {"kind": "state", "key": "view", "path": "/currentBranch"}},
        {"type": "text", "id": "targetLabel", "style": {"fontSize": 13, "color": "textMuted"}, "text": {"kind": "literal", "value": "选择要切换的分支"}},
        {"type": "column", "id": "branchControls", "enabled": {"kind": "state", "key": "idle"}, "layout": {"gap": 12}, "children": [
          {"type": "select", "id": "branch", "layout": {"height": {"fixed": 38}}, "enabled": {"kind": "state", "key": "view", "path": "/hasBranches"}, "value": {"kind": "state", "key": "branch"}, "options": {"kind": "state", "key": "view", "path": "/branches"}, "optionsFormat": "lines", "placeholder": {"kind": "literal", "value": "读取分支后，在此选择"}, "events": {"change": "selectBranch"}},
          {"type": "row", "id": "branchButtons", "layout": {"gap": 10, "wrap": true}, "children": [
            {"type": "button", "id": "refreshButton", "layout": {"height": {"fixed": 38}}, "text": {"kind": "literal", "value": "读取 / 刷新分支"}, "events": {"click": "refresh"}},
            {"type": "button", "id": "switchButton", "layout": {"height": {"fixed": 38}}, "enabled": {"kind": "state", "key": "switchAvailable"}, "text": {"kind": "literal", "value": "切换到所选分支"}, "events": {"click": "switch"}},
            {"type": "button", "id": "pullButton", "layout": {"height": {"fixed": 38}}, "enabled": {"kind": "state", "key": "view", "path": "/ready"}, "text": {"kind": "literal", "value": "更新当前分支"}, "events": {"click": "pull"}}
          ]}
        ]},
        {"type": "text", "id": "branchHelp", "style": {"fontSize": 12, "color": "textMuted"}, "text": {"kind": "literal", "value": "选择仅指定目标；点击切换成功后，当前分支才会更新。"}}
      ]},
      {"type": "card", "id": "buildCard", "layout": {"padding": 22, "gap": 14}, "style": {"radius": 12, "borderWidth": 1}, "children": [
        {"type": "text", "id": "buildSection", "style": {"fontSize": 12, "color": "primary"}, "text": {"kind": "literal", "value": "02  /  远程打包"}},
        {"type": "text", "id": "buildHeading", "style": {"fontSize": 22}, "text": {"kind": "literal", "value": "构建当前分支"}},
        {"type": "text", "id": "buildDescription", "style": {"fontSize": 13, "color": "textMuted"}, "text": {"kind": "literal", "value": "将左侧显示的当前分支打包为 TMS 开发环境版本。"}},
        {"type": "column", "id": "buildControls", "enabled": {"kind": "state", "key": "idle"}, "children": [
          {"type": "button", "id": "buildButton", "layout": {"height": {"fixed": 46}}, "style": {"background": "primary", "color": "onPrimary", "radius": 8, "fontSize": 16}, "enabled": {"kind": "state", "key": "view", "path": "/ready"}, "text": {"kind": "literal", "value": "开始打包"}, "events": {"click": "build"}}
        ]},
        {"type": "text", "id": "lastBuildLabel", "style": {"fontSize": 12, "color": "textMuted"}, "text": {"kind": "literal", "value": "最近一次打包"}},
        {"type": "text", "id": "buildResult", "style": {"fontSize": 16}, "text": {"kind": "state", "key": "view", "path": "/buildResult"}},
        {"type": "text", "id": "buildBranch", "style": {"fontSize": 13, "color": "textMuted"}, "text": {"kind": "state", "key": "view", "path": "/buildBranch"}},
        {"type": "text", "id": "buildTime", "style": {"fontSize": 12, "color": "textMuted"}, "text": {"kind": "state", "key": "view", "path": "/buildTime"}}
      ]}
    ]},
    {"type": "card", "id": "runningCard", "visible": {"kind": "state", "key": "busy"}, "layout": {"padding": 18, "gap": 8}, "style": {"radius": 10, "borderWidth": 1}, "children": [
      {"type": "text", "id": "runningTitle", "style": {"fontSize": 17, "color": "primary"}, "text": {"kind": "state", "key": "activeTask"}},
      {"type": "text", "id": "runningHelp", "style": {"fontSize": 13, "color": "textMuted"}, "text": {"kind": "literal", "value": "任务正在服务器执行，请稍候。完成后会自动更新结果。"}}
    ]},
    {"type": "card", "id": "resultCard", "visible": {"kind": "state", "key": "idle"}, "layout": {"padding": 18, "gap": 8}, "style": {"radius": 10, "borderWidth": 1}, "children": [
      {"type": "row", "id": "resultHeading", "layout": {"gap": 12, "align": "center"}, "children": [
        {"type": "badge", "id": "successBadge", "visible": {"kind": "state", "key": "view", "path": "/success"}, "tone": "success", "text": {"kind": "literal", "value": "已完成"}},
        {"type": "badge", "id": "failureBadge", "visible": {"kind": "state", "key": "view", "path": "/failure"}, "tone": "danger", "text": {"kind": "literal", "value": "未完成"}},
        {"type": "text", "id": "summary", "style": {"fontSize": 17}, "text": {"kind": "state", "key": "view", "path": "/summary"}}
      ]},
      {"type": "text", "id": "detail", "style": {"fontSize": 13, "color": "textMuted"}, "text": {"kind": "state", "key": "view", "path": "/detail"}}
    ]},
    {"type": "row", "id": "logControls", "layout": {"justify": "spaceBetween", "align": "center"}, "children": [
      {"type": "text", "id": "footer", "style": {"fontSize": 12, "color": "textMuted"}, "text": {"kind": "literal", "value": "vben-package  ·  构建产物保留在服务器"}},
      {"type": "button", "id": "openLogs", "text": {"kind": "literal", "value": "查看实时日志"}, "events": {"click": "openLogs"}}
    ]}
  ]},
  "actions": {
    "openSettings": {"steps": [{"type": "set", "target": "settingsOpen", "value": {"kind": "literal", "value": true}}, {"type": "set", "target": "settingsClosed", "value": {"kind": "literal", "value": false}}]},
    "closeSettings": {"steps": [{"type": "set", "target": "settingsOpen", "value": {"kind": "literal", "value": false}}, {"type": "set", "target": "settingsClosed", "value": {"kind": "literal", "value": true}}]},
    "openLogs": {"steps": [{"type": "openLogs"}]},
    "selectBranch": {"steps": [{"type": "set", "target": "switchAvailable", "value": {"kind": "literal", "value": true}}]},
    "resetProject": {"steps": [
      {"type": "set", "target": "branch", "value": {"kind": "literal", "value": ""}},
      {"type": "set", "target": "switchAvailable", "value": {"kind": "literal", "value": false}},
      {"type": "set", "target": "lastResponse", "value": {"kind": "literal", "value": "{}"}},
      {"type": "set", "target": "view", "value": {"kind": "literal", "value": {"currentBranch": "尚未读取", "branches": "", "ready": false, "hasBranches": false, "summary": "项目连接已更改，请重新读取分支", "detail": "读取后会显示当前分支和可选分支列表。", "success": false, "failure": false, "buildBranch": "—", "buildResult": "尚未打包", "buildTime": "—", "duration": "—", "project": ""}}}
    ]},
    "finish": {"steps": [
      {"type": "set", "target": "idle", "value": {"kind": "literal", "value": true}},
      {"type": "set", "target": "busy", "value": {"kind": "literal", "value": false}},
      {"type": "set", "target": "view", "value": {"kind": "literal", "value": {"currentBranch": "尚未确认", "branches": "", "ready": false, "hasBranches": false, "summary": "任务未完成", "detail": "任务超时、执行程序启动失败或结果未能读取，请查看执行详情后重试。", "success": false, "failure": true, "buildBranch": "—", "buildResult": "尚未确认", "buildTime": "—", "duration": "—", "project": ""}}},
      {"type": "parseJson", "target": "view", "value": {"kind": "state", "key": "job", "path": "/stdout"}},
      {"type": "set", "target": "lastResponse", "value": {"kind": "state", "key": "job", "path": "/stdout"}}
    ]},
    "refresh": {"steps": [
      {"type": "set", "target": "idle", "value": {"kind": "literal", "value": false}},
      {"type": "set", "target": "busy", "value": {"kind": "literal", "value": true}},
      {"type": "set", "target": "activeTask", "value": {"kind": "literal", "value": "正在读取项目分支…"}},
      {"type": "set", "target": "branch", "value": {"kind": "literal", "value": ""}},
      {"type": "set", "target": "switchAvailable", "value": {"kind": "literal", "value": false}},
      {"type": "command", "program": "pwsh.exe", "args": ["-NoLogo", "-NoProfile", "-NonInteractive", "-CommandWithArgs", {"kind": "state", "key": "commandScript"}, {"kind": "state", "key": "runner"}, "refresh", {"kind": "state", "key": "sshTarget"}, {"kind": "state", "key": "repository"}, {"kind": "state", "key": "branch"}, {"kind": "state", "key": "lastResponse"}], "timeoutMs": 120000, "target": "job", "onComplete": "finish"}
    ]},
    "switch": {"steps": [
      {"type": "set", "target": "idle", "value": {"kind": "literal", "value": false}},
      {"type": "set", "target": "busy", "value": {"kind": "literal", "value": true}},
      {"type": "set", "target": "activeTask", "value": {"kind": "literal", "value": "正在切换分支…"}},
      {"type": "command", "program": "pwsh.exe", "args": ["-NoLogo", "-NoProfile", "-NonInteractive", "-CommandWithArgs", {"kind": "state", "key": "commandScript"}, {"kind": "state", "key": "runner"}, "switch", {"kind": "state", "key": "sshTarget"}, {"kind": "state", "key": "repository"}, {"kind": "state", "key": "branch"}, {"kind": "state", "key": "lastResponse"}], "timeoutMs": 120000, "target": "job", "onComplete": "finish"}
    ]},
    "pull": {"steps": [
      {"type": "set", "target": "idle", "value": {"kind": "literal", "value": false}},
      {"type": "set", "target": "busy", "value": {"kind": "literal", "value": true}},
      {"type": "set", "target": "activeTask", "value": {"kind": "literal", "value": "正在更新当前分支代码…"}},
      {"type": "command", "program": "pwsh.exe", "args": ["-NoLogo", "-NoProfile", "-NonInteractive", "-CommandWithArgs", {"kind": "state", "key": "commandScript"}, {"kind": "state", "key": "runner"}, "pull", {"kind": "state", "key": "sshTarget"}, {"kind": "state", "key": "repository"}, {"kind": "state", "key": "branch"}, {"kind": "state", "key": "lastResponse"}], "timeoutMs": 120000, "target": "job", "onComplete": "finish"}
    ]},
    "build": {"steps": [
      {"type": "set", "target": "idle", "value": {"kind": "literal", "value": false}},
      {"type": "set", "target": "busy", "value": {"kind": "literal", "value": true}},
      {"type": "set", "target": "activeTask", "value": {"kind": "literal", "value": "正在打包当前分支，请稍候…"}},
      {"type": "command", "program": "pwsh.exe", "args": ["-NoLogo", "-NoProfile", "-NonInteractive", "-CommandWithArgs", {"kind": "state", "key": "commandScript"}, {"kind": "state", "key": "runner"}, "build", {"kind": "state", "key": "sshTarget"}, {"kind": "state", "key": "repository"}, {"kind": "state", "key": "branch"}, {"kind": "state", "key": "lastResponse"}], "timeoutMs": 3600000, "target": "job", "onComplete": "finish"}
    ]}
  }
}
