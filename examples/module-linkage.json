{
  "schemaVersion": "0.2",
  "app": {"name": "模块通信：props 与 emit", "window": {"width": 800, "height": 600}},
  "state": {},
  "actions": {},
  "root": {
    "type": "module", "id": "page", "layout": {"padding": 20, "gap": 16},
    "state": {"sharedMessage": "等待编辑模块发送内容"},
    "actions": {
      "receiveMessage": {"steps": [{"type": "set", "target": "sharedMessage", "value": {"kind": "event"}}]}
    },
    "children": [
      {"type": "text", "id": "heading", "text": {"kind": "literal", "value": "输入 → 子模块 emit → 父模块处理 → props 更新预览"}},
      {
        "type": "module", "id": "editor",
        "state": {"draft": "编辑模块的局部内容"},
        "props": {"currentMessage": {"kind": "state", "key": "sharedMessage"}},
        "emits": {"messageChanged": ""},
        "on": {"messageChanged": "receiveMessage"},
        "actions": {
          "publish": {"steps": [{"type": "emit", "event": "messageChanged", "payload": {"kind": "state", "key": "draft"}}]}
        },
        "children": [
          {"type": "card", "id": "editorCard", "title": {"kind": "literal", "value": "编辑模块"}, "layout": {"padding": 16, "gap": 8}, "children": [
            {"type": "input", "id": "draftInput", "value": {"kind": "state", "key": "draft"}, "events": {"change": "publish"}},
            {"type": "button", "id": "publishButton", "text": {"kind": "literal", "value": "发送当前内容"}, "events": {"click": "publish"}},
            {"type": "text", "id": "editorEcho", "text": {"kind": "prop", "key": "currentMessage"}}
          ]}
        ]
      },
      {
        "type": "module", "id": "preview",
        "props": {"message": {"kind": "state", "key": "sharedMessage"}},
        "children": [
          {"type": "card", "id": "previewCard", "title": {"kind": "literal", "value": "预览模块（只读 props）"}, "layout": {"padding": 16}, "children": [
            {"type": "text", "id": "previewText", "text": {"kind": "prop", "key": "message"}}
          ]}
        ]
      }
    ]
  }
}
